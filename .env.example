# AI SOC Pod — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── LLM Inference ─────────────────────────────────────────────────────────────
# Dev phase (M1-M3): Together.ai
# Staging/prod (M4+): vLLM on H100 — change VLLM_BASE_URL only
VLLM_BASE_URL=https://api.together.xyz/v1
VLLM_API_KEY=your_together_ai_key_here
# Staging/prod: VLLM_BASE_URL=http://vllm-service:8000/v1

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://soc:soc@localhost:5432/socdev
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=soc_metrics

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:socredis@localhost:6379
TENANT_IDS=tenant-pilot-id,eval-tenant-id

# ── OPA ───────────────────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181/v1/data/sao/agent/policy
# SAO migration: OPA_URL=http://opa.sao-platform:8181/v1/data/sao/agent/policy

# ── Lightweight HITL UI ────────────────────────────────────────────────────────
HITL_UI_URL=http://localhost:8090
# SAO migration: remove this — SAO HITL dashboard takes over

# ── Wazuh (per client — set during onboarding) ────────────────────────────────
WAZUH_BASE_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-api
WAZUH_API_PASS=your_wazuh_api_password

# ── Autobahn (Threat Hunter only) ─────────────────────────────────────────────
AUTOBAHN_BASE_URL=https://api.autobahn.io
AUTOBAHN_API_KEY=your_autobahn_key_here

# ── S3 (MY node only — AWS ap-southeast-5) ────────────────────────────────────
# AWS_REGION=ap-southeast-5
# SAO_ARTIFACT_BUCKET=soc-pod-artifacts-my
# TENANT_KMS_KEY_ARN=arn:aws:kms:ap-southeast-5:...

# ── Agent IDs (stable — never change after first deployment) ──────────────────
TRIAGE_AGENT_ID=SOC-TRIAGE-001
AUDITOR_AGENT_ID=SOC-AUDITOR-001
COMPLIANCE_AGENT_ID=SOC-COMPLIANCE-001
REMEDIATION_AGENT_ID=SOC-REMEDIATION-001
HUNTER_AGENT_ID=SOC-HUNTER-001
